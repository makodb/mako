#include "constants.h"
#include "mako_commands.h"
#include <string>
using rrr::Fiber;
%%

namespace janus;

abstract service MultiPaxos {
  defer ForwardToLearnerServer(i32 par_id,
                               uint64_t slot,
                               ballot_t ballot,
                               Command cmd | uint64_t ret_slot, ballot_t ret_ballot);

  defer BulkAccept(Command cmd | i32 ballot, i32 val);
  defer SyncLog(Command cmd | i32 ballot, i32 val, Command ret);
  defer BulkDecide(Command cmd | i32 ballot, i32 val);
}


abstract service Raft {

  fiber Vote(uint64_t lst_log_idx,
                ballot_t lst_log_term,
                siteid_t site_id,
                ballot_t cur_term|
                ballot_t max_ballot,
                bool_t vote_granted );

  // VoteDurable - Sent by follower AFTER vote is persisted to disk
  // Enables speculative voting: leader knows when vote is durable
  fiber VoteDurable(ballot_t term,
                    siteid_t voter_id |
                    bool_t acknowledged );

  fiber AppendEntries(uint64_t slot,
                      ballot_t ballot,
                      uint64_t leaderCurrentTerm,
                      siteid_t leaderSiteId,
                      uint64_t leaderPrevLogIndex,
                      uint64_t leaderPrevLogTerm,
                      uint64_t leaderCommitIndex,
                      Command cmd,
                      uint64_t leaderNextLogTerm |
                      uint64_t followerAppendOK,
                      uint64_t followerCurrentTerm,
                      uint64_t followerLastLogIndex,
                      uint64_t followerAckType);

  fiber EmptyAppendEntries(uint64_t slot,
                           ballot_t ballot,
                           uint64_t leaderCurrentTerm,
                           siteid_t leaderSiteId,
                           uint64_t leaderPrevLogIndex,
                           uint64_t leaderPrevLogTerm,
                           uint64_t leaderCommitIndex,
                           bool_t trigger_election_now |
                           uint64_t followerAppendOK,
                           uint64_t followerCurrentTerm,
                           uint64_t followerLastLogIndex,
                           uint64_t followerAckType);

  // AppendEntriesDurable - Sent by follower AFTER log entries are persisted to disk
  // Enables speculative commits: leader tracks memory vs durable acknowledgments
  fiber AppendEntriesDurable(ballot_t term,
                             siteid_t follower_id,
                             uint64_t lastLogIndex |
                             bool_t acknowledged);

  fiber TimeoutNow(uint64_t leaderTerm,
                   siteid_t leaderSiteId |
                   uint64_t followerTerm,
                   bool_t success);

  // NotifyRestart - Sent by a server after it restarts to tell other servers
  // to reconnect their client connections to it
  fiber NotifyRestart(siteid_t restartedSiteId |
                      bool_t acknowledged);

  // InstallSnapshot - Sent by leader to follower that is too far behind
  // Transfers the full snapshot in one RPC (no chunking)
  fiber InstallSnapshot(uint64_t term,
                        uint64_t leader_id,
                        uint64_t last_included_index,
                        uint64_t last_included_term,
                        string data |
                        uint64_t term_out);

  // Membership changes - single-server protocol
  fiber AddServer(uint64_t term, uint64_t new_server_id, string new_server_addr |
                  bool_t success, string error_msg, uint64_t leader_hint);

  fiber RemoveServer(uint64_t term, uint64_t server_id |
                     bool_t success, string error_msg, uint64_t leader_hint);

}

abstract service ServerControl {
    defer server_shutdown ( | );
    defer server_ready ( | i32 res);
    defer server_heart_beat ( | );
}

// Config key-value read service - lets a non-shard-0 node read a single
// key from shard 0's __mako_config__ system table (via a KvStore-backed
// handler, i.e. an OrderedIndexKvStore over shard 0's FullOrderedIndex).
// This is the transport for RemoteKvStore's ReadFn: cluster metadata
// lives on shard 0, everyone else discovers it by reading these keys.
// Distinct from ConfigService (which serves the c-node's ConfigStore).
abstract service ConfigKvService {
    // Point read of one config key. found=1 with value on hit, found=0
    // (empty value) on miss.
    defer ReadConfigKey(string key | i32 found, string value);
}
%%
