#include "procedure.h"
#include "rcc/tx.h"
#include "rrr/misc/any_message.hpp"  // graph fields are AnyMessage
%%

namespace janus;

abstract service MultiPaxos {

  // removed `Forward(cmd, dep_id | coro_id)`
  // RPC declaration — no sender (`MultiPaxosCommo::SendForward` was
  // never called) and no real handler (`MultiPaxosServiceImpl::
  // Forward` had an empty body marked "Mako uses OnForwardToLearner
  // instead").  The matching `OnForward` server-side impl was already
  // removed in Phase 4e-37.

  defer Prepare(uint64_t slot,
                ballot_t ballot |
                ballot_t max_ballot,
                uint64_t coro_id);

  defer Accept(uint64_t slot,
               uint64_t time,
               ballot_t ballot,
               Command cmd |
               ballot_t max_ballot,
               uint64_t coro_id);

  defer Decide(uint64_t slot,
               ballot_t ballot,
               Command cmd);

  // Mako's bulk Paxos operations for optimized batching
  // removed `Heartbeat`, `BulkPrepare`,
  // `SyncNoOps` RPC declarations — became dead in Phase 4e-25 when the
  // matching `PaxosWorker::SendHeartBeat` / `SendBulkPrepare` /
  // `SendSyncNoOpLog` senders went away.  No callers, no service-side
  // handlers remain.

  defer ForwardToLearnerServer(i32 par_id,
                               uint64_t slot,
                               ballot_t ballot,
                               Command cmd | uint64_t ret_slot, ballot_t ret_ballot);

  defer BulkAccept(Command cmd | i32 ballot, i32 val);

  // removed `BulkPrepare2` RPC declaration
  // — the only sender (`BulkCoordinatorMultiPaxos::Prepare()`) was
  // dead.  No callers; the matching `BroadcastPrepare2` /
  // `MultiPaxosServiceImpl::BulkPrepare2` / `OnBulkPrepare2` chain
  // is removed in this phase.

  defer SyncLog(Command cmd | i32 ballot, i32 val, Command ret);

  defer SyncCommit(Command cmd | i32 ballot, i32 val);

  defer BulkDecide(Command cmd | i32 ballot, i32 val);
}


abstract service Raft {

  fiber Vote(uint64_t lst_log_idx,
                ballot_t lst_log_term,
                siteid_t site_id,
                ballot_t cur_term|
                ballot_t max_ballot,
                bool_t vote_granted );

  // VoteDurable - Sent by follower AFTER vote is persisted to disk
  // Enables speculative voting: leader knows when vote is durable
  fiber VoteDurable(ballot_t term,
                    siteid_t voter_id |
                    bool_t acknowledged );

  fiber AppendEntries(uint64_t slot,
                      ballot_t ballot,
                      uint64_t leaderCurrentTerm,
                      siteid_t leaderSiteId,
                      uint64_t leaderPrevLogIndex,
                      uint64_t leaderPrevLogTerm,
                      uint64_t leaderCommitIndex,
                      Command cmd,
                      uint64_t leaderNextLogTerm |
                      uint64_t followerAppendOK,
                      uint64_t followerCurrentTerm,
                      uint64_t followerLastLogIndex,
                      uint64_t followerAckType);

  fiber EmptyAppendEntries(uint64_t slot,
                           ballot_t ballot,
                           uint64_t leaderCurrentTerm,
                           siteid_t leaderSiteId,
                           uint64_t leaderPrevLogIndex,
                           uint64_t leaderPrevLogTerm,
                           uint64_t leaderCommitIndex,
                           bool_t trigger_election_now |
                           uint64_t followerAppendOK,
                           uint64_t followerCurrentTerm,
                           uint64_t followerLastLogIndex,
                           uint64_t followerAckType);

  // AppendEntriesDurable - Sent by follower AFTER log entries are persisted to disk
  // Enables speculative commits: leader tracks memory vs durable acknowledgments
  fiber AppendEntriesDurable(ballot_t term,
                             siteid_t follower_id,
                             uint64_t lastLogIndex |
                             bool_t acknowledged);

  fiber TimeoutNow(uint64_t leaderTerm,
                   siteid_t leaderSiteId |
                   uint64_t followerTerm,
                   bool_t success);

  // NotifyRestart - Sent by a server after it restarts to tell other servers
  // to reconnect their client connections to it
  fiber NotifyRestart(siteid_t restartedSiteId |
                      bool_t acknowledged);

  // InstallSnapshot - Sent by leader to follower that is too far behind
  // Transfers the full snapshot in one RPC (no chunking)
  fiber InstallSnapshot(uint64_t term,
                        uint64_t leader_id,
                        uint64_t last_included_index,
                        uint64_t last_included_term,
                        string data |
                        uint64_t term_out);

  // Membership changes - single-server protocol
  fiber AddServer(uint64_t term, uint64_t new_server_id, string new_server_addr |
                  bool_t success, string error_msg, uint64_t leader_hint);

  fiber RemoveServer(uint64_t term, uint64_t server_id |
                     bool_t success, string error_msg, uint64_t leader_hint);

}

// Classic prepare/commit RPCs.
abstract service Classic {
  defer MsgString(string arg | string ret);

  defer MsgMarshall(Command arg | Command ret);

//  defer Dispatch(vector<SimpleCommand> cmd |
//                 i32 res,
//                 TxnOutput output);

	defer ReElect(| bool_t success);
  defer Dispatch(i64 tid, DepId dep_id, Command cmd |
                 i32 res, TxnOutput output, uint64_t coro_id, Command view_data);
  defer Prepare(i64 tid, 
                vector<i32> sids,
                DepId dep_id | 
                i32 res,
								bool_t slow,
                uint64_t coro_id);

  defer Commit(i64 tid, DepId dep_id | i32 res, bool_t slow, uint64_t coro_id, Command view_data);

  defer Abort(i64 tid, DepId dep_id | i32 res, bool_t slow, uint64_t coro_id, Command view_data);

  defer EarlyAbort(i64 tid | i32 res);

  defer UpgradeEpoch(uint32_t curr_epoch |
                     int32_t res);

  defer TruncateEpoch(uint32_t old_epoch);
  
  defer IsLeader(locid_t cur_pause| bool_t is_leader );
  defer SimpleCmd( SimpleCommand cmd| i32 res);
  defer FailoverPauseSocketOut(| i32 res);
  defer FailoverResumeSocketOut(| i32 res);
   
  // input: contains many pieces, each piece consist of
  // | <i32 p_type> <i64 pid> <i32 input_size> <i32 max_output_size> 
  // <input_0> <input_1> ... |
  // output: contains many pieces, each piece consist of
  // | <i32 res> <i32 output_size> <output_0> <output_1> ... |
  // below is for what?

  defer rpc_null( | );
  defer RccDispatch(vector<SimpleCommand> cmd |
                    i32 res,
                    TxnOutput output,
                    AnyMessage md_graph);

  defer RccFinish(cmdid_t id,
                  AnyMessage md_graph |
                  map<uint32_t, map<int32_t, Value>> outputs);

  // defer RccInquire(epoch_t epoch,
  //                  txnid_t txn_id |
  //                  Command md_res_graph);

  defer RccInquire(txnid_t txn_id, int32_t rank |
                   map<uint64_t, parent_set_t>);

  defer RccDispatchRo(SimpleCommand cmd |
                      map<i32, Value> output);

  defer RccInquireValidation(txid_t tx_id, int32_t rank | int32_t res);

  defer RccNotifyGlobalValidation(txid_t tx_id, int32_t rank, int32_t res |);

  defer RccCommit(cmdid_t id,
                  rank_t rank,
                  int32_t need_validation,
                  parent_set_t  parents |
                  int32_t res,
                  TxnOutput output);

  defer RccPreAccept(cmdid_t txn_id,
                     rank_t rank,
                     vector<SimpleCommand> cmd |
                     i32 res,
                     parent_set_t x );

  defer RccAccept(cmdid_t txn_id,
                  i32 rank,
                  ballot_t ballot,
                  parent_set_t p  |
                  i32 res);

  defer JetpackBeginRecovery(Command old_view,
                             Command new_view, 
                             epoch_t new_view_id);

  defer JetpackPullIdSet(epoch_t jepoch,
                         epoch_t oepoch |
                         bool_t ok,
                         epoch_t reply_jepoch,
                         epoch_t reply_oepoch,
                         Command reply_old_view,
                         Command reply_new_view,
                         Command id_set);
  
  defer JetpackPullCmd(epoch_t jepoch,
                       epoch_t oepoch,
                       Command key_batch |
                       bool_t ok,
                       epoch_t reply_jepoch,
                       epoch_t reply_oepoch,
                       Command reply_old_view,
                       Command reply_new_view,
                       Command cmd_batch);
  
  defer JetpackRecordCmd(epoch_t jepoch,
                         epoch_t oepoch,
                         int32_t sid,
                         int32_t rid,
                         Command cmd_batch);
  
  defer JetpackPrepare(epoch_t jepoch,
                       epoch_t oepoch,
                       ballot_t max_seen_ballot |
                       bool_t ok,
                       epoch_t reply_jepoch,
                       epoch_t reply_oepoch,
                       Command reply_old_view,
                       Command reply_new_view,
                       ballot_t reply_max_seen_ballot,
                       ballot_t accepted_ballot,
                       int32_t replied_sid,
                       int32_t replied_set_size);
  
  defer JetpackAccept(epoch_t jepoch,
                      epoch_t oepoch,
                      ballot_t max_seen_ballot,
                      int32_t sid,
                      int32_t set_size |
                      bool_t ok,
                      epoch_t reply_jepoch,
                      epoch_t reply_oepoch,
                      Command reply_old_view,
                      Command reply_new_view,
                      ballot_t reply_max_seen_ballot);

  defer JetpackCommit(epoch_t jepoch,
                      epoch_t oepoch,
                      int32_t sid,
                      int32_t set_size);

  defer JetpackPullRecSetIns(epoch_t jepoch,
                             epoch_t oepoch,
                             int32_t sid,
                             int32_t rid |
                             bool_t ok,
                             epoch_t reply_jepoch,
                             epoch_t reply_oepoch,
                             Command reply_old_view,
                             Command reply_new_view,
                             Command cmd);

  defer JetpackFinishRecovery(epoch_t oepoch);
}

// Below is for statistics

struct ValueTimesPair {
    i64 value;
    i64 times;
}

struct DepId {
	string str;
	i64 id;
}

struct TxnInfoRes {
    i32 start_txn;  // total number of started txns
    i32 total_txn;  // total number of finished txns
    i32 total_try;  // total number of tries finished
    i32 commit_txn; // number of commit transactions
    i32 num_exhausted; // number of txns that reached the retry limit
    vector<double> this_latency; // latencies started  finish in this period
    vector<double> last_latency; // latencies started in last period, finish in this period
    vector<double> attempt_latency; // interval latencies for each attempts
    vector<double> interval_latency; // latencies finish in this period
    vector<double> all_interval_latency; // latencies finish in this period include txn's with exhausted retries
    vector<i32> num_try;
}

struct ServerResponse {
    map<string, ValueTimesPair> statistics;
    i64 r_cnt_sum;
    i64 r_cnt_num;
    i64 r_sz_sum;
    i64 r_sz_num;
}

struct ClientResponse  {
    map<i32, TxnInfoRes> txn_info; // statistics for each txn
    i64 run_sec;    // running time in seconds
    i64 run_nsec;   // running time in nano seconds
    i64 period_sec;    // running time in seconds
    i64 period_nsec;   // running time in nano seconds
    i32 is_finish;  // if client finishs
    i64 n_asking;   // asking finish request count
}

abstract service ServerControl {
    defer server_shutdown ( | );
    defer server_ready ( | i32 res);
    defer server_heart_beat_with_data ( | ServerResponse res);
    defer server_heart_beat ( | );
}

struct TxDispatchRequest {
    i32 id;
    i32 tx_type;
    vector<Value> input;
}

struct TxnDispatchResponse {
}

abstract service ClientControl {
    defer client_get_txn_names( | map<i32, string> txn_names);
    defer client_shutdown ( | );
    defer client_force_stop ( | );
    defer client_response ( DepId dep_id | ClientResponse res);
    defer client_ready ( | i32 res);
    defer client_ready_block ( | i32 res);
    defer client_start ( | );
    defer DispatchTxn(TxDispatchRequest req | TxReply result);
}

// Config key-value read service - lets a non-shard-0 node read a single
// key from shard 0's __mako_config__ system table (via a KvStore-backed
// handler, i.e. an OrderedIndexKvStore over shard 0's FullOrderedIndex).
// This is the transport for RemoteKvStore's ReadFn: cluster metadata
// lives on shard 0, everyone else discovers it by reading these keys.
// Distinct from ConfigService (which serves the c-node's ConfigStore).
abstract service ConfigKvService {
    // Point read of one config key. found=1 with value on hit, found=0
    // (empty value) on miss.
    defer ReadConfigKey(string key | i32 found, string value);
}
