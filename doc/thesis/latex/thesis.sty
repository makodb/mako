\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thesis}[2026/05/09 Mako thesis formatting]

\RequirePackage[margin=1in]{geometry}
\RequirePackage{newtxtext}
\RequirePackage{newtxmath}
\RequirePackage{setspace}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{caption}
\RequirePackage{xcolor}
\RequirePackage{csquotes}
\RequirePackage{microtype}
\RequirePackage{etoolbox}
\RequirePackage{titlesec}
\RequirePackage{tocloft}
\RequirePackage{needspace}
\RequirePackage{placeins}
\RequirePackage{indentfirst}

\hypersetup{
  hidelinks,
  linktoc=all,
  bookmarksnumbered=true,
  bookmarksopen=true
}

\singlespacing
\captionsetup{font={small,singlespacing},labelfont=bf}
\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}
\raggedbottom

\titleformat{\chapter}[display]
  {\normalfont\bfseries\Large}
  {\chaptername\ \thechapter}
  {1.1em}
  {\LARGE}
\titlespacing*{\chapter}{0pt}{0.15in}{0.85in}

\titleformat{\section}
  {\normalfont\bfseries\large}
  {\thesection}
  {0.75em}
  {}
\titlespacing*{\section}{0pt}{2.2ex plus 0.6ex minus 0.2ex}{0.9ex plus 0.2ex}

\titleformat{\subsection}
  {\normalfont\bfseries\normalsize}
  {\thesubsection}
  {0.75em}
  {}
\titlespacing*{\subsection}{0pt}{1.8ex plus 0.5ex minus 0.2ex}{0.7ex plus 0.2ex}

\newcommand{\code}[1]{\texttt{#1}}
\newcommand{\metric}[1]{\texttt{#1}}
\newcommand{\figref}[1]{Figure~\ref{#1}}
\newcommand{\tabref}[1]{Table~\ref{#1}}
\newcommand{\Mako}{Mako}
\newcommand{\Raft}{Raft}
\newcommand{\Paxos}{Paxos}
\newcommand{\ReplayPool}{ReplayPool}

\renewcommand{\contentsname}{Table of Contents}
\renewcommand{\cftfigpresnum}{Figure~}
\renewcommand{\cfttabpresnum}{Table~}
\setlength{\cftfignumwidth}{6.5em}
\setlength{\cfttabnumwidth}{6.0em}
\renewcommand{\cfttoctitlefont}{\normalfont\bfseries\LARGE}
\renewcommand{\cftloftitlefont}{\normalfont\bfseries\LARGE}
\renewcommand{\cftlottitlefont}{\normalfont\bfseries\LARGE}
\renewcommand{\cftaftertoctitle}{\par\vspace{0.22in}}
\renewcommand{\cftafterloftitle}{\par\vspace{0.35in}}
\renewcommand{\cftafterlottitle}{\par\vspace{0.35in}}
\setlength{\cftbeforetoctitleskip}{0.15in}
\setlength{\cftbeforeloftitleskip}{0.15in}
\setlength{\cftbeforelottitleskip}{0.15in}
\setlength{\cftbeforechapskip}{0.25em}

\newcommand{\maketitlepage}{%
  \begin{titlepage}
  \thispagestyle{empty}
  \begin{center}
  \vspace*{0.28in}
  {\normalsize\bfseries \ThesisTitle\par}
  \vspace{0.36in}
  {\normalsize A \ThesisDocumentType{} Presented\par}
  \vspace{0.32in}
  {\normalsize by\par}
  \vspace{0.25in}
  {\normalsize\bfseries \ThesisAuthor\par}
  \vspace{0.34in}
  {\normalsize to\par}
  \vspace{0.25in}
  {\normalsize The Graduate School\par}
  \vspace{0.28in}
  {\normalsize in Partial Fulfillment of the\par}
  \vspace{0.28in}
  {\normalsize Requirements\par}
  \vspace{0.28in}
  {\normalsize for the Degree of\par}
  \vspace{0.28in}
  {\normalsize\bfseries \ThesisDegree\par}
  \vspace{0.30in}
  {\normalsize in\par}
  \vspace{0.23in}
  {\normalsize\bfseries \ThesisProgram\par}
  \vfill
  {\normalsize Stony Brook University\par}
  \vspace{0.42in}
  {\normalsize\bfseries \ThesisDiplomaDate\par}
  \end{center}
  \end{titlepage}
}

\newcommand{\makesignaturepage}{%
  \clearpage
  \setcounter{page}{2}
  \thispagestyle{plain}
  \begin{center}
  \vspace*{0.35in}
  {\normalsize\bfseries Stony Brook University\par}
  \vspace{0.28in}
  {\normalsize The Graduate School\par}
  \vspace{0.55in}
  {\normalsize\bfseries \ThesisAuthor\par}
  \vspace{0.58in}
  {\normalsize We, the thesis committee for the above candidate for the\par}
  \vspace{0.28in}
  {\normalsize \ThesisDegree{} degree, hereby recommend\par}
  \vspace{0.28in}
  {\normalsize Acceptance of this thesis.\par}
  \vspace{1.05in}
  {\normalsize\bfseries \ThesisAdvisor{} -- Thesis Advisor\par}
  {\normalsize\bfseries \ThesisAdvisorAffiliation\par}
  \vspace{0.43in}
  {\normalsize\bfseries \ThesisSecondCommitteeMember{} -- Second Committee Member\par}
  {\normalsize\bfseries \ThesisSecondCommitteeMemberAffiliation\par}
  \vspace{0.43in}
  {\normalsize\bfseries \ThesisAdditionalMember{} -- Additional Member\par}
  {\normalsize\bfseries \ThesisAdditionalMemberAffiliation\par}
  \vfill
  {\normalsize This thesis is accepted by the Graduate School\par}
  \vspace{0.45in}
  {\normalsize \GraduateDean\par}
  {\normalsize Dean of the Graduate School\par}
  \end{center}
}

