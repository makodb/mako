+///
+/// Private diagnostic: keep the raw value owner, publication metadata, and
+/// the first eight inline key bytes in one aligned line. Longer arbitrary
+/// keys use the unchanged inline/overflow paths. No field is shared without
+/// the existing exclusive generation and publication protocol.
+#[repr(C, align(64))]
+pub(crate) struct Holder {
+    /// Raw application value; the allocation is retained across generations.
+    value: Vec<u8>,
+    sequence: u64,
+    table_id: u64,
+    timestamp_stamp: u64,
+    key_len: u32,
+    sealed: bool,
+    key_inline: [u8; INLINE_KEY_BYTES],
+    key_overflow: Vec<u8>,
+}
+
+// The diagnostic's intended 64-bit layout is checked, not inferred from
+// Rust's default field ordering. Correctness does not depend on cache lines.
+#[cfg(target_pointer_width = "64")]
+const _: () = {
+    assert!(std::mem::align_of::<Holder>() == 64);
+    assert!(std::mem::size_of::<Holder>() == 128);
+    assert!(std::mem::offset_of!(Holder, key_inline) + 8 <= 64);
+};
 
