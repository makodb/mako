--- a/crates/mako-engine-sto/src/prefetch.rs
+++ b/crates/mako-engine-sto/src/prefetch.rs
@@ -32,4 +32,28 @@
+/// Private diagnostic hint for a producer-owned, live holder.
+///
+/// This does not inspect the holder, change its state, or establish any
+/// synchronization. The caller still performs every ordinary terminal check.
+#[inline]
+pub(crate) fn producer_holder(holder: &crate::holder::Holder) {
+    #[cfg(all(any(target_arch = "x86", target_arch = "x86_64"), not(miri)))]
+    if supported() {
+        let address = std::ptr::from_ref(holder);
+        // SAFETY: the shared borrow keeps the initialized holder alive and
+        // unmoved through this instruction. PRFCHW uses the existing cached
+        // capability check. The hint neither reads nor modifies Rust fields.
+        unsafe {
+            core::arch::asm!(
+                "prefetchw [{address}]",
+                address = in(reg) address,
+                options(nostack, preserves_flags, readonly)
+            );
+        }
+    }
+    #[cfg(any(not(any(target_arch = "x86", target_arch = "x86_64")), miri))]
+    let _ = holder;
+}
+
 #[cfg(all(any(target_arch = "x86", target_arch = "x86_64"), not(miri)))]
 #[allow(unused_unsafe)]
 #[inline]
 fn supported() -> bool {
