index 000000000..45e18fef6
--- /dev/null
+++ b/crates/mako-cache-bench/src/bin/raw_sto_attribution/mod.rs
@@ -0,0 +1,171 @@
+//! Private raw-core attribution only. No facade API or engine source changes.
+
+use std::sync::Arc;
+
+use mako_engine::{MAX_WORKERS, TRANSACTION_ITEM_BUDGET};
+use sto_core::{CommitOutcome, Runtime, RuntimeConfig, RuntimeHealth, WorkerContext};
+use sto_masstree::{RegistryBudget, Table, TableConfig};
+
+use super::Result;
+
+fn core_config() -> RuntimeConfig {
+    RuntimeConfig::new()
+        .with_max_workers(MAX_WORKERS)
+        .with_max_items_per_transaction(4 * TRANSACTION_ITEM_BUDGET)
+        .with_max_locks_per_transaction(4 * TRANSACTION_ITEM_BUDGET)
+}
+
+fn table_config() -> TableConfig {
+    TableConfig::new()
+        .with_max_retained_records(1 << 40)
+        .with_max_retained_key_bytes(1 << 44)
+        .with_max_consumed_record_ids(1 << 32)
+        .with_blocking_structural_admission(true)
+        .with_bounded_atomic_values(true)
+        .with_record_local_versions(true)
+}
+
+pub(super) struct RawDb {
+    core: Arc<Runtime>,
+    native: masstree::Runtime,
+    table: Table,
+}
+
+impl RawDb {
+    pub(super) fn open() -> Result<Arc<Self>> {
+        let core = Runtime::new(core_config())?;
+        let native = masstree::Runtime::new(
+            masstree::RuntimeConfig::new().with_max_threads(u32::try_from(MAX_WORKERS)?),
+        )?;
+        // Mirror LocalDb's cold, process-lifetime main-thread attachment.
+        // Keeping owner zero occupied also preserves the worker owner IDs.
+        let main_native = Box::leak(Box::new(native.attach()?));
+        let _main_core = Box::leak(Box::new(core.attach()?));
+        let table = Table::new_direct_with_budget(
+            &core,
+            &native,
+            main_native,
+            table_config(),
+            RegistryBudget::new(u64::MAX),
+        )?;
+        Ok(Arc::new(Self {
+            core,
+            native,
+            table,
+        }))
+    }
+
+    pub(super) fn attach(&self) -> Result<RawWorker<'_>> {
+        // These are cold allocations, before warmup and PMU start, just as
+        // facade attachment retains boxed native and core workers. The unique
+        // mutable reference is owned by this thread; no raw alias is created.
+        let native = Box::leak(Box::new(self.native.attach()?));
+        let core = Box::leak(Box::new(self.core.attach()?));
+        Ok(RawWorker {
+            db: self,
+            native,
+            core,
+        })
+    }
+
+    pub(super) fn ensure_healthy(&self) -> Result<()> {
+        if self.core.health() != RuntimeHealth::Healthy
+            || self.native.health()? != masstree::RuntimeHealth::Healthy
+        {
+            return Err("raw STO runtime is not healthy".into());
+        }
+        Ok(())
+    }
+}
+
+pub(super) struct RawWorker<'db> {
+    db: &'db RawDb,
+    native: &'static masstree::Worker,
+    core: &'static mut WorkerContext,
+}
+
+impl RawWorker<'_> {
+    pub(super) fn put(&mut self, key: &[u8], value: &[u8]) -> Result<()> {
+        let mut transaction = self.core.begin()?;
+        // Same ordinary directory admission and owned staging API as the
+        // production facade. No resolved cache, borrowed bytes, or session.
+        let _previous_presence =
+            self.db
+                .table
+                .put_with_previous_presence(&mut transaction, self.native, key, value)?;
+        match transaction.commit()? {
+            CommitOutcome::Committed(_) => Ok(()),
+            outcome => Err(format!("raw commit failed: {outcome:?}").into()),
+        }
+    }
+
+    pub(super) fn get(&mut self, key: &[u8]) -> Result<Option<Vec<u8>>> {
+        let mut transaction = self.core.begin()?;
+        let value = self.db.table.get(&mut transaction, self.native, key)?;
+        match transaction.commit()? {
+            CommitOutcome::Committed(_) => Ok(value.map(|value| value.as_ref().to_vec())),
+            outcome => Err(format!("raw verification commit failed: {outcome:?}").into()),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn raw_configuration_matches_facade_local_policy() {
+        let config = core_config();
+        assert_eq!(
+            config.default_isolation(),
+            sto_core::IsolationMode::Serializable
+        );
+        assert_eq!(config.max_workers(), 460);
+        assert_eq!(config.max_items_per_transaction(), 2048);
+        assert_eq!(config.max_locks_per_transaction(), 2048);
+        let table = table_config();
+        assert_eq!(table.max_retained_records(), 1 << 40);
+        assert_eq!(table.max_retained_key_bytes(), 1 << 44);
+        assert_eq!(table.max_consumed_record_ids(), 1 << 32);
+        assert!(table.blocking_structural_admission());
+        assert!(table.bounded_atomic_values());
+        assert!(table.record_local_versions());
+        assert!(!table.trusted_scan_value_generation());
+    }
+
+    #[test]
+    fn raw_ordinary_owned_path_preserves_presence_abort_and_local_commit() {
+        let db = RawDb::open().unwrap();
+        let owner = Arc::clone(&db);
+        std::thread::spawn(move || {
+            let mut worker = owner.attach().unwrap();
+            let mut transaction = worker.core.begin().unwrap();
+            assert!(!owner
+                .table
+                .put_with_previous_presence(&mut transaction, worker.native, b"key", &[1; 128],)
+                .unwrap());
+            assert!(owner
+                .table
+                .put_with_previous_presence(&mut transaction, worker.native, b"key", &[2; 128],)
+                .unwrap());
+            transaction.abort();
+            assert_eq!(worker.get(b"key").unwrap(), None);
+            let mut transaction = worker.core.begin().unwrap();
+            assert!(!owner
+                .table
+                .put_with_previous_presence(&mut transaction, worker.native, b"key", &[3; 128],)
+                .unwrap());
+            let CommitOutcome::Committed(info) = transaction.commit().unwrap() else {
+                panic!("raw fixture did not commit");
+            };
+            assert_eq!(info.occ_commit_id(), None);
+            assert_eq!(worker.get(b"key").unwrap(), Some(vec![3; 128]));
+            worker.put(b"key", &[4; 128]).unwrap();
+            assert_eq!(worker.get(b"key").unwrap(), Some(vec![4; 128]));
+            owner.ensure_healthy().unwrap();
+        })
+        .join()
+        .unwrap();
+        db.ensure_healthy().unwrap();
+    }
+}
