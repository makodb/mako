+//! Private cache experiment workload. This module is identical in both arms.
+
+use std::collections::BTreeMap;
+
+use super::{number, Result};
+
+pub const MAX_IDENTITIES: u64 = 1 << 22;
+const MAX_DOMAIN_BYTES: u64 = 1 << 30;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Distribution {
+    HotCycle,
+    Uniform,
+    Stream,
+    Skew,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct Workload {
+    pub requested_keys: Option<u64>,
+    pub keys: u64,
+    pub key_bytes: usize,
+    pub tables: usize,
+    pub seed: u64,
+    pub distribution: Distribution,
+}
+
+impl Workload {
+    pub fn parse(
+        flags: &mut BTreeMap<String, String>,
+        mode: &str,
+        workers: usize,
+        total: u64,
+    ) -> Result<Self> {
+        let explicit_keys = flags.remove("--keys-per-worker");
+        let distribution = match flags
+            .remove("--distribution")
+            .as_deref()
+            .unwrap_or("hot-cycle")
+        {
+            "hot-cycle" => Distribution::HotCycle,
+            "uniform" => Distribution::Uniform,
+            "stream" => Distribution::Stream,
+            "skew" => Distribution::Skew,
+            _ => return Err("unknown distribution".into()),
+        };
+        let requested_keys = if distribution == Distribution::Stream {
+            if explicit_keys.is_some() {
+                return Err("stream rejects --keys-per-worker".into());
+            }
+            None
+        } else {
+            Some(explicit_keys.map(|v| v.parse()).transpose()?.unwrap_or(256))
+        };
+        let keys = requested_keys.unwrap_or(total);
+        let key_bytes = usize::try_from(number(flags, "--key-bytes", 8)?)?;
+        let tables = usize::try_from(number(flags, "--tables", 1)?)?;
+        let seed = number(flags, "--seed", 0x1234_5678_9abc_def0)?;
+        if keys == 0
+            || !(8..=mako_engine::MAX_KEY_BYTES).contains(&key_bytes)
+            || !(1..=16).contains(&tables)
+        {
+            return Err("keys must be positive, key bytes 8..1024, and tables 1..16".into());
+        }
+        if mode == "cache-ack" && tables != 1 {
+            return Err("cache-ack supports only one table".into());
+        }
+        let identities = keys
+            .checked_mul(tables as u64)
+            .and_then(|n| n.checked_mul(workers as u64))
+            .ok_or("identity overflow")?;
+        let bytes = identities
+            .checked_mul(key_bytes as u64 + 256)
+            .ok_or("domain byte overflow")?;
+        if identities > MAX_IDENTITIES || bytes > MAX_DOMAIN_BYTES || total >= (1 << 48) {
+            return Err("private benchmark domain exceeds 4M identities, 1GiB nominal bytes, or lane sequence limit".into());
+        }
+        Ok(Self {
+            requested_keys,
+            keys,
+            key_bytes,
+            tables,
+            seed,
+            distribution,
+        })
+    }
+
+    pub fn name(self) -> &'static str {
+        match self.distribution {
+            Distribution::HotCycle => "hot-cycle",
+            Distribution::Uniform => "uniform",
+            Distribution::Stream => "stream",
+            Distribution::Skew => "skew",
+        }
+    }
+
+    /// Draws are pure functions of iteration and seed, with wrapping u64 arithmetic.
+    /// SplitMix64's finalizer receives three independent Weyl-sequence lanes.
+    #[inline]
+    pub fn identity(self, iteration: u64) -> (usize, u64) {
+        if self.distribution == Distribution::HotCycle {
+            return (
+                ((iteration / self.keys) % self.tables as u64) as usize,
+                iteration % self.keys,
+            );
+        }
+        let draw = |lane: u64| {
+            mix(self
+                .seed
+                .wrapping_add(iteration.wrapping_mul(0x9e37_79b9_7f4a_7c15))
+                .wrapping_add(lane.wrapping_mul(0xd1b5_4a32_d192_ed03)))
+        };
+        let table = (draw(2) % self.tables as u64) as usize;
+        let index = match self.distribution {
+            Distribution::Stream => iteration,
+            Distribution::Uniform => draw(0) % self.keys,
+            Distribution::Skew => {
+                draw(0)
+                    % if draw(1) % 10 < 9 {
+                        self.keys.min(16)
+                    } else {
+                        self.keys
+                    }
+            }
+            Distribution::HotCycle => unreachable!(),
+        };
+        (table, index)
+    }
+
+    /// The caller initializes one buffer per worker. No allocation occurs here.
+    #[inline]
+    pub fn encode_key(self, worker: usize, index: u64, output: &mut [u8]) {
+        debug_assert_eq!(output.len(), self.key_bytes);
+        output[..8].copy_from_slice(&((worker as u64) * self.keys + index).to_be_bytes());
+        // Fixed suffix preserves exact binary-key length as a separate dimension.
+        // The prefix already uniquely identifies every worker/key pair.
+    }
+
+    pub fn expected(self, total: u64) -> Vec<Option<u64>> {
+        let mut expected = vec![None; self.keys as usize * self.tables];
+        for iteration in 0..total {
+            let (table, key) = self.identity(iteration);
+            expected[table * self.keys as usize + key as usize] = Some(iteration);
+        }
+        expected
+    }
+}
+
+fn mix(mut value: u64) -> u64 {
+    value = (value ^ (value >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    value = (value ^ (value >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    value ^ (value >> 31)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn parse(args: &[(&str, &str)], total: u64) -> Result<Workload> {
+        Workload::parse(
+            &mut args
+                .iter()
+                .map(|(k, v)| (k.to_string(), v.to_string()))
+                .collect(),
+            "engine",
+            1,
+            total,
+        )
+    }
+
+    #[test]
+    fn default_and_mixed_cycle_cover_the_full_domain() {
+        let default = parse(&[], 1024).unwrap();
+        assert_eq!(default.keys, 256);
+        let mixed = parse(&[("--tables", "2")], 1024).unwrap();
+        assert_eq!(
+            mixed.expected(1024).iter().filter(|v| v.is_some()).count(),
+            512
+        );
+        assert_eq!(mixed.identity(256), (1, 0));
+        assert_eq!(mixed.identity(512), (0, 0));
+        assert_eq!(default.expected(1024)[0], Some(768));
+    }
+
+    #[test]
+    fn stream_and_bounds_fail_before_open() {
+        assert!(parse(
+            &[("--distribution", "stream"), ("--keys-per-worker", "256")],
+            1024
+        )
+        .is_err());
+        let stream = parse(&[("--distribution", "stream")], 1024).unwrap();
+        assert_eq!(stream.requested_keys, None);
+        assert_eq!(
+            stream.expected(1024).iter().filter(|v| v.is_some()).count(),
+            1024
+        );
+        assert!(parse(&[("--keys-per-worker", "18446744073709551615")], 1024).is_err());
+        assert!(parse(&[("--key-bytes", "1025")], 1024).is_err());
+    }
+
+    #[test]
+    fn random_schedules_replay_and_keys_remain_disjoint() {
+        for distribution in ["uniform", "skew"] {
+            let workload = parse(
+                &[
+                    ("--distribution", distribution),
+                    ("--keys-per-worker", "100"),
+                    ("--tables", "2"),
+                ],
+                1024,
+            )
+            .unwrap();
+            let expected = workload.expected(1024);
+            for (identity, last) in expected.iter().enumerate() {
+                if let Some(last) = last {
+                    assert_eq!(
+                        workload.identity(*last),
+                        (identity / 100, (identity % 100) as u64)
+                    );
+                }
+            }
+            let mut first = [0x5a; 8];
+            let mut second = [0x5a; 8];
+            workload.encode_key(0, 99, &mut first);
+            workload.encode_key(1, 0, &mut second);
+            assert_ne!(first, second);
+        }
+    }
+}

