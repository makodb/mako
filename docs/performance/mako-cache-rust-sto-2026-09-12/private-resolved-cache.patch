@@ -0,0 +1,125 @@
+//! Private bounded identity cache. No OCC token, value, or presence is cached.
+//!
+//! Entries are owned by one thread-affine WorkerSlot, whose process-lifetime
+//! retention matches the existing worker contract. Historical DB epochs are not
+//! globally bounded, though each live DB admits at most MAX_WORKERS slots.
+
+use std::collections::TryReserveError;
+use sto_masstree::{ResolvedRecord, Table};
+
+pub(crate) const ENTRIES: usize = 512;
+pub(crate) const KEY_BYTES: usize = 32;
+pub(crate) const STORAGE_BYTES: usize = 32 * 1024;
+
+#[derive(Clone, Copy)]
+#[repr(align(64))]
+struct Entry {
+    key: [u8; KEY_BYTES],
+    record: Option<ResolvedRecord>,
+    length: u8,
+}
+
+const EMPTY: Entry = Entry {
+    key: [0; KEY_BYTES],
+    record: None,
+    length: 0,
+};
+const _: () = assert!(std::mem::size_of::<Entry>() * ENTRIES == STORAGE_BYTES);
+
+pub(crate) struct ResolvedCache {
+    entries: Vec<Entry>,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum Probe {
+    Bypass,
+    Miss(usize),
+    Hit(ResolvedRecord),
+}
+
+impl ResolvedCache {
+    pub(crate) fn try_new() -> Option<Self> {
+        Self::try_new_with(|entries| entries.try_reserve_exact(ENTRIES))
+    }
+
+    fn try_new_with(
+        reserve: impl FnOnce(&mut Vec<Entry>) -> Result<(), TryReserveError>,
+    ) -> Option<Self> {
+        let mut entries = Vec::new();
+        reserve(&mut entries).ok()?;
+        // The allocator may reserve more than requested. Do not grow or shrink
+        // on that path; disabling preserves this cache's explicit byte ceiling.
+        if entries.capacity() != ENTRIES {
+            return None;
+        }
+        entries.resize(ENTRIES, EMPTY);
+        Some(Self { entries })
+    }
+
+    #[inline]
+    pub(crate) fn probe(&self, table: &Table, key: &[u8]) -> Probe {
+        if key.len() > KEY_BYTES {
+            return Probe::Bypass;
+        }
+        let bucket = bucket(table.object_id().get(), key);
+        let entry = &self.entries[bucket];
+        if entry.length as usize == key.len() && &entry.key[..key.len()] == key {
+            if let Some(record) = entry.record.filter(|record| table.owns_resolved(*record)) {
+                return Probe::Hit(record);
+            }
+        }
+        Probe::Miss(bucket)
+    }
+
+    #[inline]
+    pub(crate) fn remember(
+        &mut self,
+        bucket: usize,
+        table: &Table,
+        key: &[u8],
+        record: ResolvedRecord,
+    ) {
+        // Even an internally stale probe may only evict another exact entry.
+        // No caller may place a foreign identity behind a matching byte key.
+        assert!(key.len() <= KEY_BYTES && bucket < ENTRIES && table.owns_resolved(record));
+        let entry = &mut self.entries[bucket];
+        entry.key[..key.len()].copy_from_slice(key);
+        entry.length = key.len() as u8;
+        entry.record = Some(record);
+    }
+}
+
+fn bucket(table: u64, key: &[u8]) -> usize {
+    let mut hash = table ^ 0x9e37_79b9_7f4a_7c15;
+    for chunk in key.chunks(8) {
+        let mut bytes = [0; 8];
+        bytes[..chunk.len()].copy_from_slice(chunk);
+        hash ^= u64::from_le_bytes(bytes);
+        hash = hash.wrapping_mul(0xbf58_476d_1ce4_e5b9);
+        hash ^= hash >> 27;
+    }
+    hash ^= key.len() as u64;
+    hash = (hash ^ (hash >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    hash = (hash ^ (hash >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    ((hash ^ (hash >> 31)) as usize) & (ENTRIES - 1)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn allocation_failure_disables_and_storage_cannot_grow() {
+        let cache = ResolvedCache::try_new().unwrap();
+        assert_eq!(cache.entries.len(), ENTRIES);
+        assert_eq!(
+            cache.entries.capacity() * std::mem::size_of::<Entry>(),
+            STORAGE_BYTES
+        );
+        // A real TryReserveError takes exactly the allocation-failure branch.
+        assert!(
+            ResolvedCache::try_new_with(|entries| entries.try_reserve_exact(usize::MAX)).is_none()
+        );
+        assert!(ResolvedCache::try_new_with(|_| Ok(())).is_none());
+    }
+}
