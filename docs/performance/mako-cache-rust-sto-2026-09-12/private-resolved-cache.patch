+use super::*;
+use crate::resolved_cache::Probe;
+use std::sync::Arc;
+
+#[test]
+fn resolved_cache_checked_hit_routes_injected_tree_health_to_table_and_core() {
+    std::thread::spawn(|| {
+        let db = LocalDb::open().unwrap();
+        let table = db.open_table("checked-health", 1).unwrap();
+        let mut seed = db.transaction().unwrap();
+        seed.put(&table, b"key", b"before").unwrap();
+        seed.commit().unwrap();
+        let mut active = db.transaction().unwrap();
+        assert!(matches!(
+            active
+                .attachment
+                .slot
+                .probe_resolved(&table.entry.table, b"key"),
+            Probe::Hit(_)
+        ));
+        struct Reset;
+        impl Drop for Reset {
+            fn drop(&mut self) {
+                masstree::set_tree_runtime_health_for_test(None);
+            }
+        }
+        let _reset = Reset;
+        assert_eq!(
+            masstree::set_tree_runtime_health_for_test(Some(masstree::RuntimeHealth::Poisoned)),
+            None
+        );
+        // Exact Tree method-boundary injection. The native flag is unchanged.
+        assert_eq!(
+            table.entry.table.health(),
+            sto_masstree::TableHealth::Healthy
+        );
+        assert!(db.runtime_is_healthy());
+        assert_eq!(
+            active.put(&table, b"key", b"must-not-stage"),
+            Err(Error::WorkerPoisoned)
+        );
+        assert_eq!(
+            table.entry.table.health(),
+            sto_masstree::TableHealth::Poisoned
+        );
+        assert_eq!(
+            db.runtime_for_test().health(),
+            sto_core::RuntimeHealth::Poisoned
+        );
+        assert!(!active.active && active.inner.is_none());
+        assert_eq!(db.transaction().unwrap_err(), Error::WorkerPoisoned);
+    })
+    .join()
+    .unwrap();
+}
+
+#[test]
+fn resolved_cache_checked_warm_tombstone_scan_and_new_db_epoch() {
+    fixture(|| {
+        {
+            let db = LocalDb::open().unwrap();
+            let table = db.open_table("epoch", 1).unwrap();
+            let mut seed = db.transaction().unwrap();
+            seed.put(&table, b"key", b"before").unwrap();
+            seed.commit().unwrap();
+            let mut delete = db.transaction().unwrap();
+            assert!(delete.remove(&table, b"key").unwrap());
+            delete.commit().unwrap();
+            let mut tx = db.transaction().unwrap();
+            assert!(matches!(
+                tx.attachment
+                    .slot
+                    .probe_resolved(&table.entry.table, b"key"),
+                Probe::Hit(_)
+            ));
+            assert_eq!(tx.scan(&table, b"", None).unwrap().count(), 0);
+            assert!(tx.put(&table, b"key", b"resurrected").unwrap());
+            let rows = tx
+                .scan(&table, b"", None)
+                .unwrap()
+                .collect::<Result<Vec<_>>>()
+                .unwrap();
+            assert_eq!(rows.len(), 1);
+            tx.commit().unwrap();
+        }
+        // The old worker slot/cache remains retained, but this new core
+        // runtime and new physical table receive a different attachment.
+        let db = LocalDb::open().unwrap();
+        let table = db.open_table("epoch", 1).unwrap();
+        let mut tx = db.transaction().unwrap();
+        assert!(matches!(
+            tx.attachment
+                .slot
+                .probe_resolved(&table.entry.table, b"key"),
+            Probe::Miss(_)
+        ));
+        assert!(tx.put(&table, b"key", b"new-epoch").unwrap());
+        tx.commit().unwrap();
+    });
+}
+
+#[test]
+fn resolved_cache_health_core_poison_allows_no_successful_terminal() {
+    // Intentional quarantine retention, not a healthy-fixture teardown case.
+    std::thread::spawn(|| {
+        let db = Arc::new(LocalDb::open().unwrap());
+        let table = db.open_table("health", 1).unwrap();
+        let mut seed = db.transaction().unwrap();
+        seed.put(&table, b"key", b"before").unwrap();
+        seed.commit().unwrap();
+        let mut active = db.transaction().unwrap();
+        assert!(matches!(
+            active
+                .attachment
+                .slot
+                .probe_resolved(&table.entry.table, b"key"),
+            Probe::Hit(_)
+        ));
+        let other = Arc::clone(&db);
+        std::thread::spawn(move || {
+            #[derive(Clone)]
+            struct PanicOnDrop(Arc<AtomicBool>);
+            impl Drop for PanicOnDrop {
+                fn drop(&mut self) {
+                    assert!(
+                        !self.0.swap(false, Ordering::AcqRel),
+                        "actual core cleanup failure"
+                    );
+                }
+            }
+            let cell = sto_core::TxnCell::new(
+                other.runtime_for_test(),
+                PanicOnDrop(Arc::new(AtomicBool::new(false))),
+            )
+            .unwrap();
+            let mut fail = other.transaction().unwrap();
+            cell.set(
+                fail.inner_mut(),
+                PanicOnDrop(Arc::new(AtomicBool::new(true))),
+            )
+            .unwrap();
+            assert_eq!(fail.abort(), Err(Error::WorkerPoisoned));
+        })
+        .join()
+        .unwrap();
+        assert_eq!(
+            db.runtime_for_test().health(),
+            sto_core::RuntimeHealth::Poisoned
+        );
+        assert_eq!(
+            table.entry.table.health(),
+            sto_masstree::TableHealth::Healthy
+        );
+        assert!(matches!(
+            active
+                .attachment
+                .slot
+                .probe_resolved(&table.entry.table, b"key"),
+            Probe::Hit(_)
+        ));
+        // Core access does not reload shared runtime health on an already
+        // active transaction. Commit-start admission still rejects it.
+        assert_eq!(active.put(&table, b"key", b"not-installed"), Ok(false));
+        let report = active.commit_report();
+        assert_eq!(
+            report.disposition,
+            CommitDisposition::Aborted(Error::Internal)
+        );
+        assert_eq!(report.cleanup, Err(Error::WorkerPoisoned));
+        assert_eq!(db.transaction().unwrap_err(), Error::WorkerPoisoned);
+        std::thread::spawn(move || {
+            assert_eq!(db.transaction().unwrap_err(), Error::WorkerPoisoned);
+        })
+        .join()
+        .unwrap();
+    })
+    .join()
+    .unwrap();
+}
+
+fn fixture(body: impl FnOnce() + Send + 'static) {
+    std::thread::spawn(move || {
+        body();
+        // SAFETY: the body has retired every database/table/transaction alias.
+        unsafe { worker::drop_healthy_test_attachments() };
+    })
+    .join()
+    .unwrap();
+}
+
+#[test]
+fn resolved_cache_hit_abort_repeated_write_delete_reinsert_and_bypass() {
+    fixture(|| {
+        let db = LocalDb::open().unwrap();
+        let table = db.open_table("resolved", 1).unwrap();
+        let attachment = db.attach().unwrap();
+        assert!(matches!(
+            attachment.slot.probe_resolved(&table.entry.table, b"key"),
+            Probe::Miss(_)
+        ));
+        let mut tx = db.transaction().unwrap();
+        assert!(tx.put(&table, b"key", b"abort").unwrap());
+        assert!(matches!(
+            attachment.slot.probe_resolved(&table.entry.table, b"key"),
+            Probe::Hit(_)
+        ));
+        tx.abort().unwrap();
+        let mut tx = db.transaction().unwrap();
+        assert!(tx.put(&table, b"key", b"first").unwrap());
+        assert!(!tx.put(&table, b"key", &[7; 1024]).unwrap());
+        assert_eq!(tx.get(&table, b"key").unwrap(), Some(vec![7; 1024]));
+        tx.commit().unwrap();
+        let mut tx = db.transaction().unwrap();
+        assert!(tx.remove(&table, b"key").unwrap());
+        tx.commit().unwrap();
+        let mut tx = db.transaction().unwrap();
+        assert!(tx.put(&table, b"key", b"reinsert").unwrap());
+        tx.commit().unwrap();
+        for length in [0, 8, 32, 33, 64, 1024] {
+            let key = vec![length as u8; length];
+            let mut tx = db.transaction().unwrap();
