# Ubuntu 24.04 build environment for Mako
#
# Default: Uses native platform (ARM64 on Mac M4, AMD64 on Windows/Linux x86_64)
# To force AMD64: docker build --build-arg FORCE_AMD64=true -f Dockerfile.ubuntu24 -t mako-build:ubuntu24 .
#
FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Set working directory
WORKDIR /workspace

# Install basic dependencies
RUN apt-get update && apt-get install -y \
    sudo \
    curl \
    wget \
    git \
    build-essential \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Suppress "dubious ownership" warnings for bind-mounted workspace repos.
RUN git config --global --add safe.directory /workspace

# Copy and run apt_packages.sh to install all dependencies
COPY apt_packages.sh /tmp/apt_packages.sh
RUN bash /tmp/apt_packages.sh && rm /tmp/apt_packages.sh

# Install Rust and rust-src from official static tarballs. The compile-fail
# snapshots include standard-library spans and require matching sources.
# This avoids rustup runtime issues seen in some restricted Docker environments.
# Mainline's Verus-verified native sharding (scripts/verify_native_sharding.sh,
# src/cluster/Cargo.toml) requires exactly this official release; the Rust STO
# workspace under crates/ only needs >= 1.95, so one toolchain serves both.
ARG RUST_VERSION=1.97.1
COPY scripts/ci/install_rust_toolchain.sh /tmp/install_rust_toolchain.sh
RUN bash /tmp/install_rust_toolchain.sh "${RUST_VERSION}" /opt/rust \
    && rm /tmp/install_rust_toolchain.sh
# rust-src is a separate official component. Verify it against the checksum
# published beside the archive, the same way install_rust_toolchain.sh
# verifies the compiler, then prove the workspace's clippy/rustfmt gates and
# the standard-library sources are really present. The sources carry no
# version of their own, so a stamp file records the release they belong to;
# the CI job reinstalls rust-src unless that stamp matches its compiler
# (.github/workflows/ci.yml, "Install Rust workspace components").
RUN set -eux; \
    rust_src_tarball="rust-src-${RUST_VERSION}.tar.gz"; \
    work="$(mktemp -d)"; \
    cd "${work}"; \
    curl --proto '=https' --tlsv1.2 -fL --retry 3 \
      --output "${rust_src_tarball}" \
      "https://static.rust-lang.org/dist/${rust_src_tarball}"; \
    curl --proto '=https' --tlsv1.2 -fL --retry 3 \
      --output "${rust_src_tarball}.sha256" \
      "https://static.rust-lang.org/dist/${rust_src_tarball}.sha256"; \
    sha256sum --check --strict "${rust_src_tarball}.sha256"; \
    tar xzf "${rust_src_tarball}"; \
    "./rust-src-${RUST_VERSION}/install.sh" --prefix=/opt/rust; \
    printf '%s\n' "${RUST_VERSION}" > /opt/rust/lib/rustlib/src/mako-rust-src-version; \
    cd /; \
    rm -rf "${work}"; \
    test -r /opt/rust/lib/rustlib/src/rust/library/core/src/marker.rs; \
    export PATH="/opt/rust/bin:${PATH}"; \
    cargo clippy --version; \
    rustfmt --version
ENV PATH="/opt/rust/bin:${PATH}"

# Pre-create build directory
RUN mkdir -p /workspace/build

# Set up environment for build
ENV MODE=perf
ENV ENABLE_BORROW_CHECKING=OFF

# Default command
CMD ["/bin/bash"]
