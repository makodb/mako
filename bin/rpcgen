#!/usr/bin/env python3

import sys
import os
import argparse
sys.path += os.path.abspath(os.path.join(os.path.split(__file__)[0], "../src/srpc/pylib")),
from simplerpcgen import rpcgen

def main():
    argparser = argparse.ArgumentParser(prog=sys.argv[0])
    argparser.add_argument("--cpp", action="store_true", help="generate C++ stub files")
    argparser.add_argument("--python", action="store_true", help="generate Python stub files")
    # Backward-compatible no-op: typed mode is now the default/only C++ mode.
    argparser.add_argument("--cpp-mode", default="typed", help=argparse.SUPPRESS)
    # Workstream N Phase 3e: emit additional BinaryWriteArchive /
    # BinaryReadArchive operator<<>> overloads alongside the Marshal&
    # ones. Default ON as of Phase 3e — every in-tree .rpc file now
    # references types (MarshallDeputy via Phase 3f-prep, Value via
    # Phase 4d-6) that have archive overloads, so the default is safe.
    # Use `--no-archive` to opt out (e.g., when generating against a
    # custom .rpc that uses user types without archive overloads).
    argparser.add_argument(
        "--archive",
        dest="archive",
        action="store_true",
        default=True,
        help="emit BinaryWriteArchive / BinaryReadArchive operator<<>> overloads (default)",
    )
    argparser.add_argument(
        "--no-archive",
        dest="archive",
        action="store_false",
        help="suppress BinaryWriteArchive / BinaryReadArchive operator<<>> overloads",
    )
    argparser.add_argument("rpc_file")
    opt = argparser.parse_args()
    languages = set()
    if opt.cpp:
        languages.add("cpp")
    if opt.python:
        languages.add("python")
    if len(languages) == 0:
        languages.add("cpp")
    rpcgen(opt.rpc_file, languages, archive=opt.archive)

if __name__ == "__main__":
    main()
