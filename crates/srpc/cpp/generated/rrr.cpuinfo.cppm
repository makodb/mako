    *out_end_shadow1 = std::move(end);
}

uint64_t cpuinfo_parse_field(std::span<const uint8_t> bytes, size_t line_start, size_t line_end, size_t wanted) {
    auto start = std::move(line_start);
    while ((rusty::detail::deref_if_pointer_like(start) < rusty::detail::deref_if_pointer_like(line_end)) && (bytes[start] == static_cast<uint8_t>(32))) {
        start += static_cast<size_t>(1);
    }
    size_t field = static_cast<size_t>(0);
    while (rusty::detail::deref_if_pointer_like(start) < rusty::detail::deref_if_pointer_like(line_end)) {
        auto end = std::move(start);
        while ((rusty::detail::deref_if_pointer_like(end) < rusty::detail::deref_if_pointer_like(line_end)) && (bytes[end] != static_cast<uint8_t>(32))) {
            end += static_cast<size_t>(1);
        }
        if (rusty::detail::deref_if_pointer_like(field) == rusty::detail::deref_if_pointer_like(wanted)) {
            return ::rrr::cpuinfo_parse_ulong_range(std::span<const uint8_t>(rusty::as_slice(bytes)), std::move(start), std::move(end));
        }
        start = std::move(end);
        while ((rusty::detail::deref_if_pointer_like(start) < rusty::detail::deref_if_pointer_like(line_end)) && (bytes[start] == static_cast<uint8_t>(32))) {
            start += static_cast<size_t>(1);
        }
        field += static_cast<size_t>(1);
    }
    return static_cast<uint64_t>(0);
}

uint64_t cpuinfo_parse_ulong_range(std::span<const uint8_t> bytes, size_t start, size_t end) {
    rusty::Vec<uint8_t> token = rusty::Vec<uint8_t>::new_();
    auto index = std::move(start);
    while (rusty::detail::deref_if_pointer_like(index) < rusty::detail::deref_if_pointer_like(end)) {
        token.push(bytes[index]);
        index += static_cast<size_t>(1);
    }
    token.push(static_cast<uint8_t>(0));
    const auto pointer = reinterpret_cast<const std::string::value_type*>(rusty::as_ptr(token));
    // @unsafe
    {
        return static_cast<uint64_t>(::std::strtoul(std::move(pointer), rusty::ptr::null_mut(), static_cast<int32_t>(0)));
    }
}


rusty::Vec<double> CPUInfo::cpu_stat() {
    static rusty::Mutex<rusty::Option<CPUInfo>> INSTANCE = rusty::Mutex<rusty::Option<CPUInfo>>::new_(rusty::Option<CPUInfo>{rusty::None});
    auto slot = INSTANCE.lock().unwrap();
    if ((*slot).is_none()) {
        *slot = rusty::Option<CPUInfo>(::rrr::cpuinfo_new());
    }
    return ::rrr::cpuinfo_get_cpu_stat((*slot).as_mut().unwrap());
}

} // namespace rrr
