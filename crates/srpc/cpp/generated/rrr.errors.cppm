if (_m == 103) return std::string_view("NETWORK_UNREACHABLE");
if (_m == 104) return std::string_view("HOST_UNREACHABLE");
if (_m == 105) return std::string_view("CONNECTION_CLOSED");
if (_m == 106) return std::string_view("CIRCUIT_OPEN");
if (_m == 200) return std::string_view("INVALID_MESSAGE");
if (_m == 201) return std::string_view("UNKNOWN_RPC_ID");
if (_m == 202) return std::string_view("MARSHALLING_ERROR");
if (_m == 203) return std::string_view("VERSION_MISMATCH");
if (_m == 204) return std::string_view("CHECKSUM_ERROR");
if (_m == 300) return std::string_view("RPC_FAILED");
if (_m == 301) return std::string_view("SERVICE_UNAVAILABLE");
if (_m == 302) return std::string_view("PERMISSION_DENIED");
if (_m == 303) return std::string_view("INVALID_ARGUMENT");
if (_m == 304) return std::string_view("NOT_FOUND");
if (_m == 305) return std::string_view("ALREADY_EXISTS");
if (_m == 400) return std::string_view("CONNECT_TIMEOUT");
if (_m == 401) return std::string_view("REQUEST_TIMEOUT");
if (_m == 402) return std::string_view("RESPONSE_TIMEOUT");
if (_m == 403) return std::string_view("IDLE_TIMEOUT");
if (_m == 404) return std::string_view("HEARTBEAT_TIMEOUT");
if (_m == 500) return std::string_view("UNKNOWN_ERROR");
if (_m == 501) return std::string_view("OUT_OF_MEMORY");
if (_m == 502) return std::string_view("INVALID_STATE");
if (_m == 503) return std::string_view("INTERNAL_ERROR");
return std::string_view("UNKNOWN"); }();
